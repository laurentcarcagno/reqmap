# Copy to .env and adjust values
DATABASE_URL=sqlite+aiosqlite:///./data/reqmap.db
CORS_ORIGINS=["http://localhost:3000"]
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=52428800
CUSTOMERS_CONFIG_PATH=../config/customers.json
JWT_SECRET_KEY=change-me-in-production
DEBUG=false
# pdf2md server that converts the PDFs (token: 'Agents IA (MCP)' page of the server)
PDF2MD_URL=https://pdf2md.karka.lan
PDF2MD_TOKEN=p2m_...
# PDF2MD_CA_BUNDLE=/path/to/root.crt   # when the server uses a private CA

