{
  "customers": {
    "airbus": {
      "label": "Airbus",
      "req_id_pattern": "^(HAR\\s+SSOW-\\d+(?=\\s*/\\s*\\S)|[A-Z0-9]+-[A-Z0-9]+-\\d+/[A-Z0-9-]*/(?:[A-Z]+(?:,[A-Z]+)*)?(?=\\s|$))\\s*/?\\s*(.*?)\\s*$",
      "title_pattern": null,
      "noise_patterns": [
        "^\\s*Airbus\\s+Amber\\s*$",
        "^\\s*unclassified\\s*$",
        "^\\s*AIRBUS\\s*$",
        "OGM-SOW-ADSF.*?Page\\s+\\d+",
        "^\\s*#{1,6}\\s+\\*?\\*?(?:AIRBUS|Harness\\s+SOW|Airbus\\s+Amber|Remarks?:|Notes?:|None\\.|unclassified)\\*?\\*?\\s*$",
        "^\\s*\\*\\*Harness\\s+SOW\\*\\*\\s*$",
        "^\\s*\\*\\*==>.*?<==\\*\\*\\s*$",
        "^\\s*\\*\\*-{5}\\s+(?:Start|End)\\s+of\\s+picture\\s+text\\s+-{5}\\*\\*",
        "^#+\\s+\\*?\\*?End\\s+of\\s+Document\\*?\\*?\\s*$",
        "^\\s*S2NG-SP-ADSF-SYS-\\s*$",
        "^\\s*#{1,6}\\s+Thermal\\s+Hardware\\s+\\d+\\s*$",
        "^\\s*Specification\\s+Issue\\s+\\d+",
        "^\\s*End\\s+of\\s+Document\\s*$",
        "^\\s*Airbus\\s+Defence\\s+and\\s+Space\\s+GmbH\\s+owns\\s+the\\s+copyright",
        "^\\s*Requirement/Section\\s+Cross\\s+Reference",
        "\\.{5,}",
        "^\\s*(?:[A-Z0-9]+-[A-Z0-9]+-\\d+\\s*)+$"
      ]
    },
    "tas": {
      "label": "Thales Alénia Space",
      "req_id_pattern": "^<a id=\"[^\"]+\"></a>\\*\\*(\\S+)(?:\\s+(.*?))?\\*\\*$",
      "title_pattern": "^(?=\\s*#{1,6}\\s|\\s*\\d+\\.\\d)\\s*(?:#{1,6}\\s+)?\\*{0,2}(\\d+(?:\\.\\d+)*)\\.?\\s+(.*?)\\*{0,2}\\s*$",
      "noise_patterns": [
        "^\\s*<!--\\s*end\\s+\\S+\\s*-->\\s*$"
      ],
      "post_process": {
        "Thales Alénia Space": "pdf2md/examples/plugins/thales_alenia_space.py"
      }
    }
  }
}
